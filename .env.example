# ──────────────────────────────────────────────────────────────
# GST Billing Software — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# Per Agreement §10, infra/API costs are the Client's responsibility.
# ──────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=4000
API_PREFIX=api

# Database (PostgreSQL)
DATABASE_URL=postgresql://gst_app:change_me@localhost:5432/gst_billing?schema=public
# Restricted role used for tenant-scoped queries (RLS enforced). Do NOT use a superuser.
DATABASE_APP_ROLE=gst_app

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Redis (cache + queues)
REDIS_URL=redis://localhost:6379

# Object storage (per-tenant buckets/prefixes)
S3_REGION=ap-south-1
S3_BUCKET=gst-billing-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Government / GST APIs (Client provides credentials) ──
# e-Invoice (NIC IRP). Token TTL: 1h sandbox / 6h production.
EINVOICE_BASE_URL=https://einv-apisandbox.nic.in
EINVOICE_CLIENT_ID=
EINVOICE_CLIENT_SECRET=
EINVOICE_GSTIN=
EINVOICE_USERNAME=
EINVOICE_PASSWORD=

# e-Way Bill
EWAYBILL_BASE_URL=https://docs.ewaybillgst.gov.in
EWAYBILL_CLIENT_ID=
EWAYBILL_CLIENT_SECRET=

# GST portal / returns filing
GSTN_API_BASE_URL=https://developer.gst.gov.in/apiportal
GSTN_API_KEY=

# Tax rates
FASTGST_API_URL=
FASTGST_API_KEY=

# ── Payment gateway (choose one: razorpay | payu | stripe) ──
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER_API_KEY=
