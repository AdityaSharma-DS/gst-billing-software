# ──────────────────────────────────────────────────────────────
# GST Billing Software — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# Per Agreement §10, infra/API costs are the Client's responsibility.
# ──────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=4000
API_PREFIX=api

# Database (PostgreSQL)
DATABASE_URL=postgresql://gst_app:change_me@localhost:5432/gst_billing?schema=public
# Restricted role used for tenant-scoped queries (RLS enforced). Do NOT use a superuser.
DATABASE_APP_ROLE=gst_app

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Redis (cache + queues)
REDIS_URL=redis://localhost:6379

# Object storage (per-tenant buckets/prefixes)
S3_REGION=ap-south-1
S3_BUCKET=gst-billing-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── GST APIs via WhiteBooks GSP (developer.whitebooks.in) ──
# WhiteBooks issues ONE Client ID/Secret per account, covering e-Invoice,
# e-Way Bill, GSTR filing, GSTR-2B and Payment APIs. The GSP wraps NIC's
# AES/RSA encryption, so you send plain JSON + credentials.
# Token TTL: 1h (sandbox) / 6h (production).
GSP_PROVIDER=whitebooks
GSP_ENV=sandbox                              # sandbox | production
GSP_BASE_URL=https://api.whitebooks.in       # confirm exact host from WhiteBooks Resources
GSP_EMAIL=                                   # your WhiteBooks account email (required for auth)
GSP_CLIENT_ID=                               # sandbox: GSTS... / production: GSTP...
GSP_CLIENT_SECRET=
# Per-taxpayer e-Invoice/e-Way Bill portal username+password are stored on the
# Organization (Settings → GST APIs), not here. Sandbox test creds are per test
# GSTIN (see Api-docs/Sandbox Credentials.pdf).

# Tax rates
FASTGST_API_URL=
FASTGST_API_KEY=

# ── Payment gateway (choose one: razorpay | payu | stripe) ──
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER_API_KEY=

# WhatsApp via Twilio (invoice sending). Sandbox from-number: whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Public base URL of this API (needed so WhatsApp can fetch the invoice PDF media)
APP_PUBLIC_URL=
