# ──────────────────────────────────────────────────────────────
# GST Billing Software — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# Per Agreement §10, infra/API costs are the Client's responsibility.
# ──────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=4000
API_PREFIX=api

# Database (PostgreSQL)
DATABASE_URL=postgresql://gst_app:change_me@localhost:5432/gst_billing?schema=public
# Restricted role used for tenant-scoped queries (RLS enforced). Do NOT use a superuser.
DATABASE_APP_ROLE=gst_app

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Encryption key for secrets at rest (GSP/taxpayer password, WhiteBooks client
# secret). Any long random string; REQUIRED in production. Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_me_to_a_long_random_string

# CORS: comma-separated allowed origins. Leave blank for same-origin only
# (the Vercel deploy serves the SPA and API on one origin). e.g.:
# CORS_ORIGINS=https://app.donicy.in
CORS_ORIGINS=

# Redis (cache + queues)
REDIS_URL=redis://localhost:6379

# ── Object storage (durable PDFs / logos) ──
# Driver auto-selects: Vercel Blob (if BLOB_READ_WRITE_TOKEN set) > S3 (if
# S3_BUCKET set) > local disk. On Vercel the local disk is /tmp (ephemeral), so
# set one of these in production or archived PDFs and uploaded logos are lost.
#
# Vercel Blob (recommended on Vercel): add Blob storage in the Vercel dashboard
# (Storage → Blob) — it injects BLOB_READ_WRITE_TOKEN automatically.
BLOB_READ_WRITE_TOKEN=
#
# S3-compatible alternative (AWS S3, Cloudflare R2, Backblaze B2…):
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # set for R2/B2/MinIO (leave blank for AWS)
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=          # public base URL if not the default bucket endpoint

# ── GST APIs via WhiteBooks GSP (developer.whitebooks.in) ──
# WhiteBooks issues ONE Client ID/Secret per account, covering e-Invoice,
# e-Way Bill, GSTR filing, GSTR-2B and Payment APIs. The GSP wraps NIC's
# AES/RSA encryption, so you send plain JSON + credentials.
# Token TTL: 1h (sandbox) / 6h (production).
GSP_PROVIDER=whitebooks
GSP_ENV=sandbox                              # sandbox | production
GSP_BASE_URL=https://api.whitebooks.in       # confirm exact host from WhiteBooks Resources
GSP_EMAIL=                                   # your WhiteBooks account email (required for auth)
GSP_CLIENT_ID=                               # sandbox: GSTS... / production: GSTP...
GSP_CLIENT_SECRET=
# Per-taxpayer e-Invoice/e-Way Bill portal username+password are stored on the
# Organization (Settings → GST APIs), not here. Sandbox test creds are per test
# GSTIN (see Api-docs/Sandbox Credentials.pdf).

# Tax rates
FASTGST_API_URL=
FASTGST_API_KEY=

# ── Payment gateway (choose one: razorpay | payu | stripe) ──
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER_API_KEY=

# WhatsApp via Twilio (invoice sending). Sandbox from-number: whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Public base URL of this API (needed so WhatsApp can fetch the invoice PDF media)
APP_PUBLIC_URL=
