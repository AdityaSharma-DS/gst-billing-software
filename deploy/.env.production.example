# ── DONICY API — production environment ─────────────────────────────
# Copy to /var/www/donicy/api/.env and fill in. Never commit the real file.

NODE_ENV=production
PORT=4000
API_PREFIX=api

# Postgres — TWO connections so tenant isolation is enforced by the database:
#  APP_DATABASE_URL → least-privilege gst_app (NOBYPASSRLS). All tenant queries run
#     here and are filtered by Row-Level Security.
#  DATABASE_URL → privileged role (superuser or a role created WITH BYPASSRLS). Used
#     for migrations and for auth/operator lookups that run before a tenant context
#     exists. Keep it server-side only; never reachable from tenant requests.
APP_DATABASE_URL=postgresql://gst_app:STRONG_APP_PASSWORD@localhost:5432/gst_billing?schema=public
DATABASE_URL=postgresql://gst_admin:STRONG_ADMIN_PASSWORD@localhost:5432/gst_billing?schema=public

# Auth — MUST be a long random secret (e.g. `openssl rand -hex 48`)
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Public URL of the API origin (used for WhatsApp media links, etc.)
APP_PUBLIC_URL=https://app.donicy.in

# GST APIs via WhiteBooks GSP (production creds — set in the master-admin panel,
# or here as a fallback). Use GSTP… (production) client id/secret when going live.
GSP_PROVIDER=whitebooks
GSP_ENV=production
GSP_BASE_URL=https://api.whitebooks.in
GSP_EMAIL=
GSP_IP_ADDRESS=            # this server's whitelisted public IP
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=

# Email (invoices/receipts) & WhatsApp (Twilio) — optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Object storage — leave S3 blank to use local disk (apps/backend/storage)
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
