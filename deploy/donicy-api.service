# systemd unit for the DONICY NestJS API.
# Install:  sudo cp deploy/donicy-api.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now donicy-api
# Logs:     journalctl -u donicy-api -f

[Unit]
Description=DONICY GST Billing API (NestJS)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=donicy
WorkingDirectory=/var/www/donicy/api
EnvironmentFile=/var/www/donicy/api/.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
